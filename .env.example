# Дев-подпись для вкладки DumbGallery: витрина поднимает ручку /api/sign, и
# галерея заливает в настоящее S3-совместимое хранилище.
#
# ТОЛЬКО ДЛЯ РАЗРАБОТКИ. Плагин объявлен `apply: 'serve'` — в собранную витрину
# он не попадает, на Pages никакой подписи нет. Ключи остаются на твоей машине:
# .env под .gitignore, наружу уходит подписанная ссылка на один объект.
#
# Всё кладётся под префикс `dumb-kit-dev/` — чтобы отличить и вычистить.

S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# по какому адресу объект виден снаружи; без него плитка после заливки опустеет
S3_WEB_ENDPOINT=
