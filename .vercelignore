# Что НЕ надо отправлять на хостинг.
#
# Vercel загружает проект целиком, а тут 236 МБ одних `node_modules` (pnpm с её
# `.pnpm` — это ещё и десятки тысяч файлов и симлинков). Без этого списка CLI
# уходит их перебирать и висит.
#
# Серверу нужно немного: `mcp/`, `api/`, `public/` и то, из чего собирается
# снимок, — исходники пакетов, примеры, доки, правила.

node_modules
.git
.github

# собранные пакеты: они для потребителей, ставящих кит с GitHub, а снимок
# строится по `src`
packages/*/dist

# витрина — отдельный деплой, на GitHub Pages
playground

# Манифесты корня: из-за них Vercel лезет ставить зависимости (а в них два
# десятка `workspace:*`, которых npm не понимает, и падает pnpm-установка).
# Серверу ставить нечего вовсе — сборка описана в `vercel.json`, а функции
# импортируют только `node:` и соседние файлы.
# Слэш в начале обязателен: без него шаблон бьёт по ЛЮБОМУ уровню и уносит
# `packages/*/package.json` — а из них строится список пакетов, и на хостинге
# он молча оказывается пустым.
/package.json
/pnpm-lock.yaml
/pnpm-workspace.yaml

# производные и локальный мусор
mcp/snapshot.json
probe-*.mjs
probe-*.png
shot-*.mjs
shot-*.png
.env
.env.*
