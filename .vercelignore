# Что НЕ надо отправлять на хостинг.
#
# Vercel загружает проект целиком, а тут 236 МБ одних `node_modules` (pnpm с её
# `.pnpm` — это ещё и десятки тысяч файлов и симлинков). Без этого списка CLI
# уходит их перебирать и висит.
#
# Серверу нужно немного: `mcp/`, `api/`, `public/` и то, из чего собирается
# снимок, — исходники пакетов, примеры, доки, правила.

node_modules
.git
.github

# собранные пакеты: они для потребителей, ставящих кит с GitHub. Снимок
# строится по `src`, витрина — тоже (условие экспорта solid-dumb-kit-source)
packages/*/dist

# сборка витрины: делается на месте, из репы приезжать не должна
playground/dist

# производные и локальный мусор
mcp/snapshot.json
probe-*.mjs
probe-*.png
shot-*.mjs
shot-*.png
.env
.env.*
