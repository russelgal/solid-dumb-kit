{
  "name": "solid-dumb-kit",
  "private": true,
  "description": "SolidJS UI kit: sortable, selection, grids, table, tree — one package per feature",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/russelgal/solid-dumb-kit"
  },
  "scripts": {
    "opus": "claude --model opus --dangerously-skip-permissions ",
    "fable": "claude --model fable --dangerously-skip-permissions ",
    "build": "pnpm -r --filter './packages/*' run build",
    "demo": "vite playground",
    "demo:build": "vite build playground && cp playground/dist/index.html playground/dist/404.html",
    "dev": "pnpm -r --parallel --filter './packages/*' run dev",
    "dev:s3:clean": "node scripts/dev-s3-clean.mjs",
    "release": "pnpm build && node scripts/tag.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "changeset version && pnpm i --no-frozen-lockfile && git add ."
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@changesets/cli": "^2.29.4",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/tailwind4": "^1.2.3",
    "@shikijs/transformers": "^4.4.2",
    "@solid-dumb-kit/board": "workspace:*",
    "@solid-dumb-kit/context-menu": "workspace:*",
    "@solid-dumb-kit/date-range": "workspace:*",
    "@solid-dumb-kit/finder": "workspace:*",
    "@solid-dumb-kit/gallery": "workspace:*",
    "@solid-dumb-kit/grid": "workspace:*",
    "@solid-dumb-kit/grid-dnd": "workspace:*",
    "@solid-dumb-kit/lightbox": "workspace:*",
    "@solid-dumb-kit/modal": "workspace:*",
    "@solid-dumb-kit/odata-1c": "workspace:*",
    "@solid-dumb-kit/props-table": "workspace:*",
    "@solid-dumb-kit/resizable-grid": "workspace:*",
    "@solid-dumb-kit/selection": "workspace:*",
    "@solid-dumb-kit/shared": "workspace:*",
    "@solid-dumb-kit/sortable": "workspace:*",
    "@solid-dumb-kit/sortable-dnd": "workspace:*",
    "@solid-dumb-kit/table": "workspace:*",
    "@solid-dumb-kit/timeline": "workspace:*",
    "@solid-dumb-kit/toast": "workspace:*",
    "@solid-dumb-kit/tree": "workspace:*",
    "@solid-dumb-kit/user-manager": "workspace:*",
    "@solid-dumb-kit/utils": "workspace:*",
    "@solidjs/router": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/slug": "^5.0.9",
    "daisyui": "^5.7.9",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.1",
    "shiki": "^4.4.2",
    "solid-js": "1.9.14",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@solid-primitives/upload": "^0.1.5"
  }
}
