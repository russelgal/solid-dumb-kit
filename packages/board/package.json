{
  "name": "@solid-dumb-kit/board",
  "version": "0.2.0",
  "description": "DumbBoard — секции с блоками: перенос между секциями, сортировка и ресайз самих секций",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/russelgal/solid-dumb-kit",
    "directory": "packages/board"
  },
  "homepage": "https://github.com/russelgal/solid-dumb-kit#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid-dumb-kit-source": "./src/index.tsx",
      "solid": "./dist/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup --config ../../configs/tsup.ts",
    "dev": "tsup --config ../../configs/tsup.ts --watch"
  },
  "devDependencies": {
    "@solid-dumb-kit/grid": "workspace:*",
    "@solid-dumb-kit/shared": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
