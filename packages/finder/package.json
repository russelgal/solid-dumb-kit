{
  "name": "@solid-dumb-kit/finder",
  "version": "0.1.0",
  "description": "Файловый менеджер по чужому хранилищу: папки, выделение рамкой, заливка, перенос",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/russelgal/solid-dumb-kit",
    "directory": "packages/finder"
  },
  "homepage": "https://github.com/russelgal/solid-dumb-kit#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid-dumb-kit-source": "./src/index.tsx",
      "solid": "./dist/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup --config ../../configs/tsup.ts",
    "dev": "tsup --config ../../configs/tsup.ts --watch"
  },
  "dependencies": {
    "@solid-primitives/upload": "^0.1.5"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@solid-dumb-kit/resizable-grid": "workspace:*",
    "@solid-dumb-kit/selection": "workspace:*",
    "@solid-dumb-kit/shared": "workspace:*",
    "@solid-dumb-kit/utils": "workspace:*"
  }
}
