{
  "name": "@solid-dumb-kit/locator",
  "version": "0.0.0",
  "description": "Alt-клик по элементу открывает его разметку в редакторе",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/russelgal/solid-dumb-kit",
    "directory": "packages/locator"
  },
  "homepage": "https://github.com/russelgal/solid-dumb-kit#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index/index.js",
  "module": "./dist/index/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid-dumb-kit-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index/index.js"
      }
    },
    "./vite": {
      "solid-dumb-kit-source": "./src/vite.ts",
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup --config ../../configs/tsup.ts && tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup --config ../../configs/tsup.ts --watch"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
