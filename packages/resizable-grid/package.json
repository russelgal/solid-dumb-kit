{
  "name": "@solid-dumb-kit/resizable-grid",
  "version": "0.6.0",
  "description": "Панели с ресайзом и персистом раскладки",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/russelgal/solid-dumb-kit",
    "directory": "packages/resizable-grid"
  },
  "homepage": "https://github.com/russelgal/solid-dumb-kit#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid-dumb-kit-source": "./src/index.tsx",
      "solid": "./dist/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup --config ../../configs/tsup.ts && tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup --config ../../configs/tsup.ts --watch"
  },
  "dependencies": {
    "valibot": "^1.2.0"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-beta.30",
    "solid-js": ">=2.0.0-beta.30"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@solid-dumb-kit/shared": "workspace:*",
    "@solidjs/web": "2.0.0-beta.32"
  }
}
