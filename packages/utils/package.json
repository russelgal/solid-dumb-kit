{
  "name": "@solid-dumb-kit/utils",
  "version": "0.5.0",
  "description": "Формат, slug, zip, imgproxy",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/russelgal/solid-dumb-kit",
    "directory": "packages/utils"
  },
  "homepage": "https://github.com/russelgal/solid-dumb-kit#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid-dumb-kit-source": "./src/index.ts",
