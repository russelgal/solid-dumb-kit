  "scripts": {
    "build": "tsup --config ../../configs/tsup.ts && tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup --config ../../configs/tsup.ts --watch"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "slug": "^11.0.1"
  },
  "publishConfig": {
